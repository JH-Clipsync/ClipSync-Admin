# Caddy 反向代理配置示例
#
# 把以下内容加到 Caddyfile（通常在 /etc/caddy/Caddyfile），然后 `caddy reload`。
#
# 路径映射：
#   /clipsync/admin/api/    → admin 后端（28002）/api/
#   /clipsync/admin/static/ → admin 后端（28002）/static/
#   /clipsync/admin/        → admin-web 前端（28200）/
#   /clipsync/              → clipsync server（28001）/

www.95qw.com {
	# ClipSync Server（C 端 API + WebSocket）
	handle_path /clipsync/* {
		reverse_proxy 127.0.0.1:28001
	}

	# Admin API & 上传文件（比 /clipsync/admin/ 更具体，Caddy 会优先匹配）
	handle /clipsync/admin/api/* {
		rewrite * /api{uri}
		reverse_proxy 127.0.0.1:28002
	}
	handle /clipsync/admin/static/* {
		rewrite * /static{uri}
		reverse_proxy 127.0.0.1:28002
	}

	# Admin 前端静态资源（strip /clipsync/admin 前缀）
	handle_path /clipsync/admin/* {
		reverse_proxy 127.0.0.1:28200
	}

	# 你原有的其他站点配置...
}

# ─────────────────────────────────────────────────────────────
