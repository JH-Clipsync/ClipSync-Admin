# 部署时复制为 .env，按需修改

# Web 对外端口（宿主机端口）
WEB_PORT=28200

# Admin 后端地址。
# 生产环境（有外层反向代理，如 Caddy/Nginx 处理 /clipsync/admin/api）：
#   留空或注释掉，AdminWeb 容器只托管静态文件。
# 本地直连场景（直接访问 http://服务器IP:28200）：
#   填 http://host.docker.internal:28002，容器内 nginx 会反代 /api 和 /static。
# ADMIN_UPSTREAM=http://host.docker.internal:28002

# 镜像 tag（CI 自动部署时会覆盖为 latest，本地手动部署可指定版本）
ADMIN_TAG=latest
WEB_TAG=latest
